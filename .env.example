# --- Contact form (recommended: Web3Forms) ---
VITE_WEB3FORMS_ACCESS_KEY=

# Optional: override FormSubmit / custom POST URL
# VITE_CONTACT_FORM_ACTION=

# --- Visit section ---
# Use | between lines when a single .env line is easier (or use real newlines if your editor supports multi-line env values).
VITE_ADDRESS_LINES=123 Study Lane, Near City College | Your City, State — PIN
VITE_HOURS_LINES=Mon–Sat: 7:00 AM – 9:00 PM | Sun: Closed
VITE_FEE_NOTE=Ask at the desk for current daily / monthly seating rates.

# tel: link (include country code)
VITE_PHONE=+919876543210
# VITE_PHONE_DISPLAY=+91 98765 43210

# WhatsApp: digits only with country code → floating button + Visit card link
# VITE_WHATSAPP=919876543210

# Map embed search text, or paste full embed URL:
VITE_MAP_QUERY=Your City India
# VITE_MAP_EMBED_URL=https://www.google.com/maps/embed?pb=...
